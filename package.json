{
  "name": "tuneharbor",
  "private": true,
  "version": "0.2.8",
  "scripts": {
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:parser": "node scripts/test-changelog-parser.mjs",
    "dev": "vite --config ui/vite.config.ts",
    "build:web": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "build:android:web": "tsc -p ui/tsconfig.json && vite build --config ui/vite.android.config.ts",
    "build:android": "node scripts/build-android.mjs",
    "test:android-navigation": "node scripts/android-navigation-smoke.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "test": "npm run build:web && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "type": "module"
}
